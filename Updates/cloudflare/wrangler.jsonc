{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bilikit-updates",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "updates.shiinayane.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": false }
}
