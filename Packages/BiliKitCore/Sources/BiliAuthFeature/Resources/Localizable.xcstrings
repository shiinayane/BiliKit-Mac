{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "二维码已扫描，等待手机客户端确认登录。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "QR code scanned. Waiting for confirmation on your phone." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "QRコードをスキャンしました。スマートフォンでの確認を待っています。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "二维码已扫描，等待手机客户端确认登录。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已掃描 QR Code，正在等待手機確認登入。" } } } },
    "二维码已过期" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "QR code expired" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "QRコードの有効期限が切れました" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "二维码已过期" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "QR Code 已過期" } } } },
    "使用哔哩哔哩手机客户端扫码确认登录。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan the QR code with the Bilibili mobile app to confirm sign-in." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "BilibiliモバイルアプリでQRコードをスキャンし、ログインを確認します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用哔哩哔哩手机客户端扫码确认登录。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用 Bilibili 手機 App 掃描 QR Code 並確認登入。" } } } },
    "使用手机客户端扫描" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan with the mobile app" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "モバイルアプリでスキャン" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用手机客户端扫描" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用手機 App 掃描" } } } },
    "取消" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "キャンセル" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
    "哔哩哔哩登录二维码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bilibili sign-in QR code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Bilibiliログイン用QRコード" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "哔哩哔哩登录二维码" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Bilibili 登入 QR Code" } } } },
    "尚未登录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not signed in" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "未ログイン" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未登录" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未登入" } } } },
    "已登录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Signed in" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログイン済み" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已登录" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已登入" } } } },
    "打开哔哩哔哩手机客户端，扫描二维码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the Bilibili mobile app and scan the QR code." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Bilibiliモバイルアプリを開いて、QRコードをスキャンしてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开哔哩哔哩手机客户端，扫描二维码。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟 Bilibili 手機 App，掃描 QR Code。" } } } },
    "无法访问本机 Keychain；请解锁 Mac 后重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keychain is unavailable. Unlock your Mac and try again." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "キーチェーンにアクセスできません。Macのロックを解除してからやり直してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法访问本机 Keychain；请解锁 Mac 后重试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法存取此 Mac 的鑰匙圈；請解鎖 Mac 後再試一次。" } } } },
    "显示登录二维码" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show sign-in QR code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログイン用QRコードを表示" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示登录二维码" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "顯示登入 QR Code" } } } },
    "正在检查本机登录状态…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking sign-in status…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログイン状態を確認中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查本机登录状态…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查登入狀態…" } } } },
    "正在清除本机登录状态…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clearing sign-in data…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログイン情報を削除中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在清除本机登录状态…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在清除此 Mac 的登入狀態…" } } } },
    "正在获取登录二维码…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Getting sign-in QR code…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログイン用QRコードを取得中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在获取登录二维码…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在取得登入 QR Code…" } } } },
    "正在验证并安全保存登录状态…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Verifying and securely saving sign-in data…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "確認してログイン情報を安全に保存中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在验证并安全保存登录状态…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在驗證並安全地儲存登入狀態…" } } } },
    "清除本机登录状态" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear sign-in data" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログイン情報を削除" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清除本机登录状态" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "清除此 Mac 的登入狀態" } } } },
    "登录凭据仅保存在本机 Keychain。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign-in credentials are stored only in this Mac’s Keychain." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログイン情報はこのMacのキーチェーンにのみ保存されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录凭据仅保存在本机 Keychain。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "登入憑證只會儲存在此 Mac 的鑰匙圈中。" } } } },
    "登录协议返回了无法安全处理的数据。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The sign-in service returned data that could not be handled safely." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログインサービスから安全に処理できないデータが返されました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录协议返回了无法安全处理的数据。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "登入服務傳回了無法安全處理的資料。" } } } },
    "登录服务未接受本次请求，请重新扫码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The sign-in service rejected the request. Scan a new QR code." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログインサービスがリクエストを受け付けませんでした。新しいQRコードをスキャンしてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录服务未接受本次请求，请重新扫码。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "登入服務未接受這次要求，請重新掃描 QR Code。" } } } },
    "登录未完成" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign-in incomplete" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログインを完了できませんでした" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "登录未完成" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "登入未完成" } } } },
    "网络暂时不可用，请稍后重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The network is unavailable. Try again later." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ネットワークに接続できません。しばらくしてからやり直してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网络暂时不可用，请稍后重试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "網路目前無法使用，請稍後再試。" } } } },
    "请在手机上确认" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm on your phone" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スマートフォンで確認" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在手机上确认" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請在手機上確認" } } } },
    "请扫码登录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan to sign in" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "QRコードでログイン" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请扫码登录" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請掃描 QR Code 登入" } } } },
    "请重新生成二维码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Generate a new QR code." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいQRコードを生成してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请重新生成二维码。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請重新產生 QR Code。" } } } },
    "账号" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Account" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アカウント" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "账号" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "帳號" } } } },
    "退出登录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign out" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ログアウト" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "退出登录" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "登出" } } } },
