    "4 秒内内容相同的弹幕只显示一条，并在末尾标出条数" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identical danmaku within 4 seconds appear once, with a count at the end"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4秒以内の同じ内容の弾幕は1つにまとめ、末尾に件数を表示します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 秒内内容相同的弹幕只显示一条，并在末尾标出条数"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 秒內內容相同的彈幕只顯示一條，並在末尾標出條數"
          }
        }
      }
    },
